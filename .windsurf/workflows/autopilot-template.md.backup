   ```bash
   DEPLOY_URL=$(grep -o "https://[^[:space:]]*vercel.app" /tmp/final_deploy.log 2>/dev/null | head -1 || echo "https://foundryai-seven.vercel.app")
   
   for i in {1..10}; do
     STATUS=$(curl -s -o /dev/null -w "%{http_code}" "$DEPLOY_URL" 2>/dev/null || echo "000")
     if [ "$STATUS" = "200" ]; then
       echo "✅ Deployment healthy - Status: $STATUS"
       break
     else
       echo "⚠️ Health check $i/10 - Status: $STATUS"
       sleep 10
     fi
   done
   
   echo "### $(date '+%Y-%m-%d %H:%M:%S') - Post-Deploy Health Check" >> /home/mo/CascadeProjects/FoundryAI/ERROR_LOG.md
   echo "" >> /home/mo/CascadeProjects/FoundryAI/ERROR_LOG.md
   echo "**Deployment URL:** $DEPLOY_URL" >> /home/mo/CascadeProjects/FoundryAI/ERROR_LOG.md
   echo "**Status:** $(if [ "$STATUS" = "200" ]; then echo "✅ HEALTHY"; else echo "⚠️ CHECK REQUIRED"; fi)" >> /home/mo/CascadeProjects/FoundryAI/ERROR_LOG.md
   echo "" >> /home/mo/CascadeProjects/FoundryAI/ERROR_LOG.md
   ```

